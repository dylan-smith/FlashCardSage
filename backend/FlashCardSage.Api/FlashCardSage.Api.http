@FlashCardSage.Api_HostAddress = http://localhost:5269
@contentType = application/json
# Development turns test sign-in on, so any "test:<name>" token signs in as that name.
@token = test:Me

GET {{FlashCardSage.Api_HostAddress}}/api/flashcards
Accept: {{contentType}}
Authorization: Bearer {{token}}

###

POST {{FlashCardSage.Api_HostAddress}}/api/flashcards
Content-Type: {{contentType}}
Accept: {{contentType}}
Authorization: Bearer {{token}}

{
  "spanish": ["el gato"],
  "english": ["the cat"],
  "tags": ["Animals"]
}

###

PUT {{FlashCardSage.Api_HostAddress}}/api/flashcards/1
Content-Type: {{contentType}}
Accept: {{contentType}}
Authorization: Bearer {{token}}

{
  "spanish": ["el perro", "el can"],
  "english": ["the dog"]
}

###

DELETE {{FlashCardSage.Api_HostAddress}}/api/flashcards/1
Accept: {{contentType}}
Authorization: Bearer {{token}}

###

# Everything the device needs to practice on its own: the cards with their scores, and the decks and tags.
GET {{FlashCardSage.Api_HostAddress}}/api/flashcards/practice/pack
Accept: {{contentType}}
Authorization: Bearer {{token}}

###

# The answers the device kept, oldest first. Each id is the device's, so an answer sent again isn't recorded twice.
POST {{FlashCardSage.Api_HostAddress}}/api/flashcards/practice-results
Content-Type: {{contentType}}
Accept: {{contentType}}
Authorization: Bearer {{token}}

{
  "results": [
    {
      "id": "8a1f0c6e-3b7d-4c55-9a43-5f0e2d6b7c11",
      "flashCardId": 1,
      "outcome": "GotIt",
      "practicedAt": "2026-10-01T09:00:00Z"
    }
  ]
}

###

GET {{FlashCardSage.Api_HostAddress}}/api/flashcards/scores
Accept: {{contentType}}
Authorization: Bearer {{token}}

###

GET {{FlashCardSage.Api_HostAddress}}/api/tags
Accept: {{contentType}}
Authorization: Bearer {{token}}

###

PUT {{FlashCardSage.Api_HostAddress}}/api/tags/1
Content-Type: {{contentType}}
Accept: {{contentType}}
Authorization: Bearer {{token}}

{
  "name": "Pets"
}

###

DELETE {{FlashCardSage.Api_HostAddress}}/api/tags/1
Accept: {{contentType}}
Authorization: Bearer {{token}}

###

GET {{FlashCardSage.Api_HostAddress}}/api/decks
Accept: {{contentType}}
Authorization: Bearer {{token}}

###

POST {{FlashCardSage.Api_HostAddress}}/api/decks
Content-Type: {{contentType}}
Accept: {{contentType}}
Authorization: Bearer {{token}}

{
  "name": "Week 1",
  "flashCardIds": [1]
}

###

PUT {{FlashCardSage.Api_HostAddress}}/api/decks/1
Content-Type: {{contentType}}
Accept: {{contentType}}
Authorization: Bearer {{token}}

{
  "name": "Week one"
}

###

PATCH {{FlashCardSage.Api_HostAddress}}/api/decks/1/cards
Content-Type: {{contentType}}
Accept: {{contentType}}
Authorization: Bearer {{token}}

{
  "add": [2, 3],
  "remove": [1]
}

###

DELETE {{FlashCardSage.Api_HostAddress}}/api/decks/1
Accept: {{contentType}}
Authorization: Bearer {{token}}

###
