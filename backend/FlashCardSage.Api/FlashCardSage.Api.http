@FlashCardSage.Api_HostAddress = http://localhost:5269
@contentType = application/json
# Development turns test sign-in on, so any "test:<name>" token signs in as that name.
@token = test:Me

GET {{FlashCardSage.Api_HostAddress}}/api/flashcards
Accept: {{contentType}}
Authorization: Bearer {{token}}

###

POST {{FlashCardSage.Api_HostAddress}}/api/flashcards
Content-Type: {{contentType}}
Accept: {{contentType}}
Authorization: Bearer {{token}}

{
  "spanish": "el gato",
  "english": "the cat",
  "tags": ["Animals"]
}

###

PUT {{FlashCardSage.Api_HostAddress}}/api/flashcards/1
Content-Type: {{contentType}}
Accept: {{contentType}}
Authorization: Bearer {{token}}

{
  "spanish": "el perro",
  "english": "the dog"
}

###

DELETE {{FlashCardSage.Api_HostAddress}}/api/flashcards/1
Accept: {{contentType}}
Authorization: Bearer {{token}}

###

GET {{FlashCardSage.Api_HostAddress}}/api/flashcards/practice/next
Accept: {{contentType}}
Authorization: Bearer {{token}}

###

# Practice a deck's cards, or a tag's with ?tagId=1. The practice result POST takes the same query.
GET {{FlashCardSage.Api_HostAddress}}/api/flashcards/practice/next?deckId=1
Accept: {{contentType}}
Authorization: Bearer {{token}}

###

POST {{FlashCardSage.Api_HostAddress}}/api/flashcards/1/practice-results
Content-Type: {{contentType}}
Accept: {{contentType}}
Authorization: Bearer {{token}}

{
  "outcome": "GotIt"
}

###

GET {{FlashCardSage.Api_HostAddress}}/api/flashcards/scores
Accept: {{contentType}}
Authorization: Bearer {{token}}

###

GET {{FlashCardSage.Api_HostAddress}}/api/tags
Accept: {{contentType}}
Authorization: Bearer {{token}}

###

PUT {{FlashCardSage.Api_HostAddress}}/api/tags/1
Content-Type: {{contentType}}
Accept: {{contentType}}
Authorization: Bearer {{token}}

{
  "name": "Pets"
}

###

DELETE {{FlashCardSage.Api_HostAddress}}/api/tags/1
Accept: {{contentType}}
Authorization: Bearer {{token}}

###

GET {{FlashCardSage.Api_HostAddress}}/api/decks
Accept: {{contentType}}
Authorization: Bearer {{token}}

###

POST {{FlashCardSage.Api_HostAddress}}/api/decks
Content-Type: {{contentType}}
Accept: {{contentType}}
Authorization: Bearer {{token}}

{
  "name": "Week 1",
  "flashCardIds": [1]
}

###

PUT {{FlashCardSage.Api_HostAddress}}/api/decks/1
Content-Type: {{contentType}}
Accept: {{contentType}}
Authorization: Bearer {{token}}

{
  "name": "Week 1",
  "flashCardIds": [1, 2]
}

###

DELETE {{FlashCardSage.Api_HostAddress}}/api/decks/1
Accept: {{contentType}}
Authorization: Bearer {{token}}

###
