@description('Azure region for resources.')
param location string

@description('Name of the App Service Plan.')
param planName string

@description('Name of the App Service (web app).')
param appName string

@description('SKU for the App Service Plan.')
param planSku string

@description('Resource ID of the Application Insights component.')
param appInsightsId string

@description('Application Insights connection string.')
param appInsightsConnectionString string

@description('Application Insights instrumentation key.')
param appInsightsInstrumentationKey string

@description('Resource ID of the Log Analytics Workspace that receives the App Service diagnostic logs.')
param logAnalyticsWorkspaceId string

@description('SQL connection string used by the API at runtime.')
@secure()
param sqlConnectionString string

@description('Origins allowed to call the API via CORS (the frontend static website).')
param corsAllowedOrigins string[]

@description('Google OAuth client ID whose ID tokens the API accepts for sign-in.')
param googleClientId string

@description('Secret token that signs in as the service user, for the smoke and load tests.')
@secure()
param serviceToken string

@description('Token of the PostHog project the API sends its AI model calls to. Empty sends nothing.')
param posthogProjectToken string = ''

@description('PostHog\'s ingestion host for the project.')
param posthogHost string = 'https://us.i.posthog.com'

@description('Name of the Azure AI Translator resource the API translates cards with.')
param translatorName string

@description('Name of the Azure AI Foundry resource the API makes cards\' pictures with. Empty turns pictures off, while there isn\'t one.')
param foundryName string = ''

@description('Name of the image model\'s deployment on the Azure AI Foundry resource.')
param imageDeploymentName string

@description('Name of the chat model\'s deployment on the Azure AI Foundry resource, which suggests new cards.')
param suggestionDeploymentName string

@description('Name of the Storage Account the API keeps cards\' pictures in.')
param storageAccountName string

@description('Name of the container in the Storage Account for cards\' pictures.')
param cardImagesContainerName string

resource translator 'Microsoft.CognitiveServices/accounts@2024-10-01' existing = {
  name: translatorName
}

resource foundry 'Microsoft.CognitiveServices/accounts@2025-06-01' existing = if (!empty(foundryName)) {
  name: foundryName
}

resource storageAccount 'Microsoft.Storage/storageAccounts@2025-01-01' existing = {
  name: storageAccountName
}

// Free and Shared plans don't support Always On.
var isFreeOrShared = startsWith(planSku, 'F') || startsWith(planSku, 'D')

resource appServicePlan 'Microsoft.Web/serverfarms@2024-11-01' = {
  name: planName
  location: location
  kind: 'linux'
  sku: {
    name: planSku
  }
  properties: {
    // Marks the plan as Linux; the OS can't be changed on an existing plan.
    reserved: true
  }
}

resource appService 'Microsoft.Web/sites@2024-11-01' = {
  name: appName
  location: location
  kind: 'app,linux'
  // Links the web app to Application Insights in the portal.
  tags: {
    'hidden-link: /app-insights-resource-id': appInsightsId
  }
  identity: {
    type: 'SystemAssigned'
  }
  properties: {
    serverFarmId: appServicePlan.id
    httpsOnly: true
    autoGeneratedDomainNameLabelScope: 'TenantReuse'
    siteConfig: {
      linuxFxVersion: 'DOTNETCORE|10.0'
      alwaysOn: !isFreeOrShared
      minTlsVersion: '1.2'
      ftpsState: 'FtpsOnly'
    }
  }
}

// This replaces the app's entire settings collection, so every setting the app needs must be declared here.
resource appSettings 'Microsoft.Web/sites/config@2024-11-01' = {
  parent: appService
  name: 'appsettings'
  properties: union(
    {
      ConnectionStrings__FlashCardSage: sqlConnectionString
      Authentication__Google__ClientId: googleClientId
      Authentication__ServiceToken: serviceToken
      Translator__Key: translator.listKeys().key1
      // The API writes pictures with the account's key: the web app's identity can't be given a role here, since
      // the deployment identity isn't allowed to assign roles.
      ImageStore__StorageConnectionString: 'DefaultEndpointsProtocol=https;AccountName=${storageAccount.name};AccountKey=${storageAccount.listKeys().keys[0].value};EndpointSuffix=${environment().suffixes.storage}'
      ImageStore__ContainerName: cardImagesContainerName
      APPLICATIONINSIGHTS_CONNECTION_STRING: appInsightsConnectionString
      APPINSIGHTS_INSTRUMENTATIONKEY: appInsightsInstrumentationKey
      WEBSITE_ENABLE_SYNC_UPDATE_SITE: 'true'
    },
    toObject(range(0, length(corsAllowedOrigins)), i => 'Cors__AllowedOrigins__${i}', i => corsAllowedOrigins[i]),
    // Without an endpoint and key the API answers picture and suggestion requests with a 503, and cards go without
    // pictures and the page without suggestions. The endpoints are the resource's Foundry and Azure OpenAI ones, on
    // its subdomain (modules/foundry.bicep names it after the resource).
    empty(foundryName)
      ? {}
      : {
          ImageGeneration__Endpoint: 'https://${foundry!.name}.services.ai.azure.com/'
          ImageGeneration__Key: foundry!.listKeys().key1
          ImageGeneration__Deployment: imageDeploymentName
          CardSuggestions__Endpoint: 'https://${foundry!.name}.openai.azure.com/'
          CardSuggestions__Key: foundry!.listKeys().key1
          CardSuggestions__Deployment: suggestionDeploymentName
        },
    // Without a project token the API sends PostHog nothing.
    empty(posthogProjectToken)
      ? {}
      : {
          PostHog__ProjectToken: posthogProjectToken
          PostHog__HostUrl: posthogHost
          PostHog__Environment: 'production'
        }
  )
}

resource diagnostics 'Microsoft.Insights/diagnosticSettings@2021-05-01-preview' = {
  scope: appService
  name: 'logs-to-workspace'
  properties: {
    workspaceId: logAnalyticsWorkspaceId
    logAnalyticsDestinationType: 'Dedicated'
    logs: [
      for category in [
        'AppServiceHTTPLogs'
        'AppServiceConsoleLogs'
        'AppServiceAppLogs'
        'AppServicePlatformLogs'
      ]: {
        category: category
        enabled: true
      }
    ]
  }
}

@description('Default HTTPS URL of the App Service.')
output appServiceUrl string = 'https://${appService.properties.defaultHostName}'

@description('Principal ID of the App Service system-assigned managed identity.')
output principalId string = appService.identity.principalId

@description('Resource ID of the App Service.')
output appServiceId string = appService.id

@description('Resource ID of the App Service Plan.')
output appServicePlanId string = appServicePlan.id
