{
  "name": "FlashCardSage",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/FlashCardSage",
  "shutdownAction": "stopCompose",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24"
    },
    "ghcr.io/devcontainers/features/azure-cli:1": {
      "installBicep": true
    },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
  },
  "containerEnv": {
    "UseInMemoryDatabase": "false",
    "ConnectionStrings__FlashCardSage": "Server=localhost,1433;Database=FlashCardSage;User Id=sa;Password=FlashCardSage_Dev_P@ssw0rd;TrustServerCertificate=True",
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude"
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "forwardPorts": [5269, 5173, 4173],
  "portsAttributes": {
    "5269": { "label": "API" },
    "5173": { "label": "Frontend (Vite dev)" },
    "4173": { "label": "Frontend (Vite preview)" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-playwright.playwright",
        "ms-azuretools.vscode-bicep",
        "ms-mssql.mssql",
        "EditorConfig.EditorConfig"
      ]
    }
  }
}
